flowchart LR
  DEP(["Depositors: researchers, students, external programs"])
  STAFF(["SDR staff: accessioning, metadata, developers"])
  PUB(["Public users"])
  DISC(["Discovery users"])

  subgraph SDR["Stanford Digital Repository"]
    MGMT["Management and deposit apps"]:::app
    CORE["Repository core: DSA"]:::app
    ACC["Accessioning robots"]:::app
    PRES["Preservation: Moab and catalog"]:::app
  end

  subgraph ACCESS["Access and discovery"]
    DELIV["Publication and delivery: purl, stacks, embed, images, streaming, replay"]:::app
    IDX["Discovery: SearchWorks, EarthWorks, Exhibits, content search"]:::app
  end

  IDP["Shibboleth IdP and Workgroup Manager"]:::ext
  GLOBUS["Globus"]:::ext
  FOLIO["FOLIO"]:::ext
  DATACITE["DataCite"]:::ext
  ORCID["ORCID and MaIS"]:::ext
  ABBYY["ABBYY OCR server"]:::ext
  AWS["AWS: S3 us-west-2 and us-east-1, Batch, SQS"]:::ext
  GCP["GCP: storage us-south1"]:::ext
  OTHER["Archive-It, Google GRIN, Registrar, Goobi"]:::ext

  DEP -->|"HTTPS web or API"| MGMT
  DEP -->|"large uploads"| GLOBUS
  STAFF -->|"HTTPS"| MGMT
  PUB -->|"HTTPS"| DELIV
  DISC -->|"HTTPS"| IDX
  IDX -->|"links and viewers"| DELIV

  MGMT -->|"login"| IDP
  DELIV -->|"login for restricted files"| IDP
  GLOBUS -->|"NFS"| MGMT
  MGMT --> CORE
  OTHER -->|"content and metadata"| MGMT
  CORE --> ACC
  ACC --> PRES
  CORE -->|"publish"| DELIV
  DELIV -->|"release, Kafka"| IDX

  CORE -->|"HTTPS: MARC, HRIDs, 856 links"| FOLIO
  CORE -->|"HTTPS: DOIs"| DATACITE
  CORE -->|"HTTPS: works"| ORCID
  ACC -->|"CIFS hot folders"| ABBYY
  ACC -->|"speech-to-text"| AWS
  PRES -->|"zip parts, S3"| AWS
  PRES -->|"zip parts"| GCP

  classDef app fill:#e8f1fb,stroke:#2b6cb0;
  classDef store fill:#fef6e4,stroke:#b7791f;
  classDef ext fill:#f0f0f0,stroke:#666,stroke-dasharray:4 3;
