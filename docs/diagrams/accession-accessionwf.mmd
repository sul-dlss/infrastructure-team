flowchart TB
  subgraph CA["common-accessioning robots"]
    SA["start-accession"]:::app
    ST["stage"]:::app
    TM["technical-metadata"]:::app
    EA["end-accession"]:::app
  end
  subgraph DSAR["DSA robots (_dsa queues)"]
    SH["shelve (WAS crawls only)"]:::app
    PB["publish"]:::app
    RI["release-initiate"]:::app
    DOI["update-doi"]:::app
    ORC["update-orcid-work"]:::app
    SIT["sdr-ingest-transfer"]:::app
    RW["reset-workspace"]:::app
  end
  SIR["sdr-ingest-received (skip-queue)"]:::queue

  TMS["technical-metadata-service"]:::ext
  PF["purl-fetcher"]:::ext
  DC["DataCite"]:::ext
  OR["ORCID"]:::ext
  BAG[("/dor/export bag")]:::store
  PR["preservation_robots (preservationIngestWF)"]:::app
  REL["releaseWF"]:::app
  NEXT["ocrWF, speechToTextWF or dissemination WF (v+1)"]:::app

  SA --> ST
  ST --> TM
  ST --> SH
  SH --> PB
  PB --> RI
  PB --> DOI
  PB --> ORC
  PB --> SIT
  TM --> RW
  SH --> RW
  PB --> RW
  SIR --> RW
  DOI --> EA
  ORC --> EA
  RW --> EA

  TM -.->|"POST, HTTPS"| TMS
  TMS -.->|"marks step completed, HTTPS"| TM
  PB -.->|"publish, HTTPS"| PF
  DOI -.->|HTTPS| DC
  ORC -.->|HTTPS| OR
  SIT -.->|"write bag, NFS"| BAG
  BAG -.->|"cp, NFS"| PR
  PR -.->|"marks completed, HTTPS"| SIR
  RI -.->|creates| REL
  EA -.->|"creates if flagged"| NEXT

  classDef app fill:#e8f1fb,stroke:#2b6cb0;
  classDef store fill:#fef6e4,stroke:#b7791f;
  classDef ext fill:#f0f0f0,stroke:#666,stroke-dasharray:4 3;
  classDef queue fill:#eefbea,stroke:#2f855a;
