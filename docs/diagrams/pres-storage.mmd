flowchart TB
  subgraph PROD["prod"]
    subgraph CEPHA["CephFS cluster A"]
      P1[("storage root")]:::store
      P4[("storage root (last listed: new Moabs land here)")]:::store
    end
    subgraph CEPHB["CephFS cluster B"]
      P2[("storage root")]:::store
      P3[("storage root")]:::store
    end
    PZ[("zip cache (zip_storage), NFS volume")]:::store
    PX[("/dor/export, NFS volume")]:::store
    PAPPS["pres cat web and workers, preservation-robots, techmd"]:::app
  end
  subgraph STAGE["stage"]
    S1[("storage root")]:::store
    S2[("storage root (new Moabs)")]:::store
    SZ[("zip cache (zip_storage), Ceph NFS volume")]:::store
    SAPPS["pres cat web and worker, preservation-robots, techmd"]:::app
  end
  subgraph QA["qa"]
    Q1[("storage root")]:::store
    Q2[("storage root (new Moabs)")]:::store
    QZ[("zip_storage: directory on the stage storage volume")]:::store
    QAPPS["pres cat web and worker, preservation-robots, techmd"]:::app
  end
  DEV[("/dor/export, NFS volume shared by stage and qa")]:::store

