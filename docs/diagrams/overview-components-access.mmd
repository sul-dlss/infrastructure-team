flowchart LR
  DSA["DSA publish and release robots"]:::app
  USERS(["Public and discovery users"])

  subgraph PUBL["Publication and delivery"]
    PF["purl-fetcher"]:::app
    PURL["purl"]:::app
    STACKS["stacks"]:::app
    IMG["IIIF image server"]:::app
    WOWZA["Wowza"]:::app
    EMBED["sul-embed"]:::app
    PYWB["was-pywb (SWAP)"]:::app
    METRICS["sdr-metrics-api"]:::app
  end

  STX[("/stacks shared mount")]:::store
  PS3[("S3: public stacks content")]:::store
  WAS[("/web-archiving-stacks")]:::store

  subgraph DISC["Discovery"]
    KAFKA{{"Kafka"}}:::queue
    TRAJ["searchworks_traject_indexer"]:::app
    SW["SearchWorks"]:::app
    EW["EarthWorks"]:::app
    EX["Exhibits"]:::app
    CS["content_search"]:::app
    SOLR[("SolrCloud")]:::store
  end

  DSA -->|"HTTPS JWT plus /access-transfer NFS"| PF
  DSA -->|"NFS: WARCs"| WAS
  PF -->|"NFS"| STX
  PF -->|"Kafka produce"| KAFKA
  PF -->|"HTTPS cache purge"| IMG
  PURL -->|"S3"| PS3
  STACKS -->|"S3"| PS3
  PYWB -->|"NFS"| WAS
  STACKS -->|"HTTPS public cocina"| PURL
  STACKS -->|"HTTPS proxy"| IMG
  STACKS -->|"HTTPS"| METRICS
  EMBED -->|"HTTPS"| PURL
  KAFKA --> TRAJ & EW & CS
  TRAJ -->|"HTTPS"| PURL
  TRAJ --> SOLR
  EW --> SOLR
  EX -->|"HTTPS harvest"| PURL
  EX --> SOLR
  CS --> SOLR
  SW --> SOLR
  USERS --> PURL & STACKS & EMBED & WOWZA & PYWB & SW & EW & EX

  classDef app fill:#e8f1fb,stroke:#2b6cb0;
  classDef store fill:#fef6e4,stroke:#b7791f;
  classDef ext fill:#f0f0f0,stroke:#666,stroke-dasharray:4 3;
  classDef queue fill:#eefbea,stroke:#2f855a;
