flowchart LR
  subgraph People
    STAFF["SDR staff"]:::ext
    SELF["Stanford depositors"]:::ext
    REG["Registrar (PeopleSoft)"]:::ext
    CLIU["API and CLI depositors"]:::ext
  end

  subgraph Staff_apps["Staff apps"]
    ARGO["Argo (legacy)"]:::app
    B3["Argo-B3 (replacing Argo and pre-assembly)"]:::app
    PA["pre-assembly (legacy)"]:::app
    WRA["was-registrar-app"]:::app
    RC["robot-console"]:::app
  end

  subgraph Deposit_apps["Deposit apps"]
    H3["H3 (sdr.stanford.edu)"]:::app
    ETD["Heracles ETD"]:::app
    GB["Google Books"]:::app
    SDRAPI["sdr-api"]:::app
  end

  MODS["modsulator-app"]:::app
  DSA["dor-services-app (DSA)"]:::app
  SOLR[("Solr argo_env")]:::store
  MQ{{"RabbitMQ vhost workflow"}}:::queue
  RR[("Robots Redis")]:::store
  ARCH["Archive-It WASAPI"]:::ext
  GRIN["Google GRIN"]:::ext

  STAFF --> ARGO
  STAFF --> B3
  STAFF --> PA
  STAFF --> WRA
  STAFF --> RC
  SELF --> H3
  SELF --> ETD
  REG -->|"HTTPS POST"| ETD
  CLIU -->|"sdr-client, HTTPS JWT"| SDRAPI

  ARGO -->|"HTTPS JWT"| DSA
  B3 -->|"HTTPS JWT"| DSA
  PA -->|"HTTPS JWT"| DSA
  WRA -->|"HTTPS JWT"| DSA
  H3 -->|"HTTPS JWT"| DSA
  ETD -->|"HTTPS JWT"| DSA
  SDRAPI -->|"HTTPS JWT"| DSA
  GB -->|"sdr-client, HTTPS"| SDRAPI
  ARGO -->|"token proxy, agreements"| SDRAPI
  ARGO -->|"HTTPS"| MODS
  GRIN -->|"HTTPS OAuth"| GB
  ARCH -->|"WARC download"| WRA

  ARGO -->|"read"| SOLR
  B3 -->|"read"| SOLR
  RC -->|"Sidekiq Web"| RR
  B3 -->|"AMQP sdr.objects.event"| MQ
  H3 -->|"AMQP sdr.objects.event"| MQ
  MQ -->|"h3.deposit_complete"| H3
  MQ -->|"preassembly.accession_complete"| PA

  classDef app fill:#e8f1fb,stroke:#2b6cb0;
  classDef store fill:#fef6e4,stroke:#b7791f;
  classDef ext fill:#f0f0f0,stroke:#666,stroke-dasharray:4 3;
  classDef queue fill:#eefbea,stroke:#2f855a;
