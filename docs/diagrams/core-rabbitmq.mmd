flowchart LR
  subgraph Publishers
    EVPUB["dor-event-client users: Argo-B3, H3, preservation_catalog, EarthWorks, SearchWorks indexer, dataworks-etl"]:::app
    DSAPUB["DSA"]:::app
  end

  subgraph Broker["sul-rabbit-env, vhost workflow"]
    XEV{{"exchange sdr.objects.event (topic)"}}:::queue
    XWF{{"exchange sdr.workflow (topic)"}}:::queue
    XCR{{"exchange sdr.objects.created (topic)"}}:::dead
    XEM{{"exchange sdr.objects.embargo_lifted (topic)"}}:::dead
    QEV[["queue dsa.create-event"]]:::queue
    QH3[["queue h3.deposit_complete"]]:::queue
    QPA[["queue preassembly.accession_complete"]]:::queue
    QIX[["queue dor.indexing-by-druid (DEAD)"]]:::dead
  end

  CEV["DSA Sneakers CreateEventJob"]:::app
  CH3["H3 DepositCompleteJob"]:::app
  CPA["pre-assembly AccessionCompleteJob"]:::app
  NONE["no consumer"]:::ext

  EVPUB -->|"key: event type"| XEV
  DSAPUB -->|"key: process.status"| XWF
  DSAPUB -->|"key: project tag"| XCR
  DSAPUB -->|"key: project tag or SDR"| XEM
  XEV -->|"bind #"| QEV
  XWF -->|"bind end-accession.completed"| QH3
  XWF -->|"bind end-accession.completed, *.error"| QPA
  XWF -->|"bind #"| QIX
  QEV --> CEV
  QH3 --> CH3
  QPA --> CPA
  QIX -.-> NONE
  XCR -.->|"no binding"| NONE
  XEM -.->|"no binding"| NONE

  classDef app fill:#e8f1fb,stroke:#2b6cb0;
  classDef store fill:#fef6e4,stroke:#b7791f;
  classDef ext fill:#f0f0f0,stroke:#666,stroke-dasharray:4 3;
  classDef queue fill:#eefbea,stroke:#2f855a;
  classDef dead fill:#fdecec,stroke:#c53030,stroke-dasharray:4 3;
