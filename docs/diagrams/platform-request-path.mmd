flowchart LR
  U["Browser or API client"]
  F5["UIT F5 load balancer"]
  IDP["Stanford IdP (SAML, eduPersonEntitlement)"]
  WGM["Workgroup Manager (sdr:*, dlss:* groups)"]

  subgraph VM["SDR app VM (puppet-managed)"]
    AP["Apache 2.4 :443 (Let's Encrypt cert, mod_shib)"]
    PA["A: mod_passenger (DSA, PresCat, sdr-api, Argo, pre-assembly ...)"]
    PS["B: Passenger Standalone :3000 (H3)"]
    KP["C: kamal-proxy :3000 (argo-b3)"]
    WEB["argo-b3 web container (Thruster + Puma)"]
    JOB["argo-b3 job container (SolidQueue)"]
    UW["uWSGI (was-pywb)"]
  end

  U -->|"HTTPS to LB VIP (e.g. argo, dor-services-prod-lb, purl)"| F5
  U -->|"HTTPS to single-VM FQDN (e.g. sul-h3-prod, argo-b3-prod-a)"| AP
  F5 -->|"HTTPS 443"| AP
  AP <-->|"SAML redirect"| IDP
  WGM -.->|"group membership"| IDP
  AP -->|"in-process, Shib attrs as env"| PA
  AP -->|"ProxyPass HTTP"| PS
  AP -->|"ProxyPass HTTP, X-Remote-User, X-Groups"| KP
  KP --> WEB
  WEB -.->|"same Postgres"| JOB
  AP -->|"ProxyPass"| UW

  classDef app fill:#e8f1fb,stroke:#2b6cb0;
  classDef ext fill:#f0f0f0,stroke:#666,stroke-dasharray:4 3;
  class AP,PA,PS,KP,WEB,JOB,UW app;
  class U,F5,IDP,WGM ext;
